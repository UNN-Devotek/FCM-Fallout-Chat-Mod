# Prisma Database URL
# Format: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
# The DATABASE_URL is constructed from the .env variables in the parent directory:
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Example (local development with Docker):
DATABASE_URL="postgresql://fo76_user:fo76_password@localhost:5432/fo76_chat"

# Example (Dokploy hosted — fill in real host/port/credentials from your .env, never commit them):
DATABASE_URL="postgresql://fo76_user:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/fo76_chat"
