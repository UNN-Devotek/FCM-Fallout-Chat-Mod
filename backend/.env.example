NODE_ENV=development
# Opt-in for credential-less dev-login + /api/admin/sim routes.
# Only honored when NODE_ENV=development; ignored in production.
ENABLE_DEV_LOGIN=false
# Optional shared key for remote hosted-DEV DevAccount requests. Local loopback
# overlay requests do not need it; never set this in production.
DEV_PERSONA_LOGIN_SECRET=
PORT=7076
DB_HOST=localhost
DB_PORT=5432
DB_USER=fo76_user
DB_PASSWORD=change-me
DB_NAME=fo76_chat
REDIS_HOST=localhost
REDIS_PORT=6379
CLIENT_ORIGINS=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-secret
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_BOT_COMMANDS_CHANNEL_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_SERVER_ID=
# Existing Discord Events text-channel snowflake used for scheduled-event announcements.
DISCORD_EVENTS_CHANNEL_ID=
# Opt-in release-announcement roles. Overlay, HUD, and combined releases mention
# only these roles; @everyone and @here are never used for release notices.
OVERLAY_UPDATE_NOTIFICATION_ROLE_ID=
HUD_MOD_UPDATE_NOTIFICATION_ROLE_ID=
DISCORD_REDIRECT_URI=http://localhost:7076/auth/discord/callback
OWNER_ROLE_ID=
ADMIN_ROLE_ID=
MODERATOR_ROLE_ID=
# Staff role for the ticketing feature (developers). Owner/Admin/Moderator reuse the ids above.
DEVELOPER_ROLE_ID=
MCP_REMOTE_ENABLED=false
MCP_ISSUER_URL=https://falloutchatmod.com
MCP_RESOURCE_URL=https://falloutchatmod.com/mcp
MCP_ALLOWED_ORIGINS=
MCP_OAUTH_STATE_SECRET=
MCP_ACCESS_TOKEN_TTL_SECONDS=600
MCP_REFRESH_TOKEN_TTL_SECONDS=259200
# Role @-pinged in bug/suggestion ticket threads (support team).
SUPPORT_ROLE_ID=

# ── Supporter cosmetics (disabled by default; enable only after both tier role IDs exist) ──
# MASTER KILL SWITCH: false makes supporter cosmetics, commands, role sync, and API
# routes inert without deleting any saved entitlement or cosmetic data. When enabled,
# ADMIN_ROLE_ID above grants the full Overseer-level cosmetics catalog only; it does not
# change moderation access.
# Defaults to false outside production. Production must explicitly set true or false;
# an omitted or malformed value is a startup error.
SUPPORTER_TIER_ENABLED=false
SUPPORTER_ROLE_ID=
OVERSEER_CIRCLE_ROLE_ID=
# Discord Server Subscriptions web purchase URL. Leave blank for local/dev role testing.
DISCORD_SERVER_SHOP_URL=

# --- GitHub ticketing (Discord <-> GitHub Issues/Projects) ---
# Fine-grained PAT (owner UNN-Devotek) with Issues: Read/Write + Projects: Read/Write.
# Leave empty to disable the ticketing feature.
GITHUB_PAT=
# Optional dedicated token for creating GitHub Releases at publish time (needs
# contents:write). Falls back to GITHUB_PAT above if unset; the GitHub-release
# step is skipped cleanly when no token/owner/repo is configured.
# GITHUB_RELEASE_TOKEN=
GITHUB_OWNER=UNN-Devotek
GITHUB_REPO=FCM-Fallout-Chat-Mod
# Single master Project v2 board (all issues + features), e.g. /users/UNN-Devotek/projects/5
GITHUB_PROJECT_NUMBER=5
# HMAC secret for verifying inbound GitHub webhooks (X-Hub-Signature-256). Set the same value on the repo webhook.
GITHUB_WEBHOOK_SECRET=

# Desktop client registration key (leave empty to skip validation)
APP_CLIENT_KEY=fo76-chat-desktop-v1

# Steam OpenID 2.0. Leave blank to derive these from the forwarded request host;
# set explicitly in production when the public proxy host differs.
# STEAM_OPENID_REALM=https://falloutchatmod.com/
# STEAM_OPENID_RETURN_URI=https://falloutchatmod.com/auth/steam/callback

# Release pipeline downloads origin (default: falloutchatmod.com). Override only
# in non-prod stacks (dev sets dev.falloutchatmod.com) so publishRelease verifies
# + links artifacts on that environment's own /downloads origin.
# RELEASE_DOWNLOAD_HOST=falloutchatmod.com

# Discord release announcement: Nexus mod page for the endorse link (default below),
# and the download-page link / embed title target. Override per environment.
# NEXUS_MOD_URL=https://www.nexusmods.com/fallout76/mods/4082
# DOWNLOAD_PAGE_URL=https://falloutchatmod.com
# DISCORD_UPDATES_CHANNEL_ID=1479531502567166066
ADMIN_RELEASE_TOKEN=change-me-to-a-long-random-secret
# Admin API key — pass as X-API-Key header to bypass Discord OAuth on all admin endpoints
ADMIN_API_KEY=change-me-to-a-long-random-secret
# chat.v1 relay rollout switch. Development/test are available; production stays
# fail-closed until this is explicitly enabled after relay smoke/load validation.
RELAY_PRODUCTION_ENABLED=false
# MinIO object storage (avatars, ban evidence, party images)
# MINIO_ENDPOINT, MINIO_BUCKET, and MINIO_PUBLIC_URL are all required in production.
# The defaults here are Docker-internal and NOT browser-reachable outside of the local dev stack.
# In production all three must be explicitly set — the startup guard will refuse to start otherwise.
# Generate: no secret needed for endpoint/bucket — use your S3-compatible host URL and bucket name.
MINIO_ENDPOINT=http://minio:9700
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=fcm-media
# Public URL that browsers use to fetch stored objects. In production this is your CDN or
# public MinIO hostname — never the Docker-internal MINIO_ENDPOINT.
# Example: https://media.falloutchatmod.com
MINIO_PUBLIC_URL=

# ── AI content moderation (OpenAI Moderation API) ─────────────────────────────
# Optional. When set AND ai_moderation_enabled=true in the moderation_settings
# table, the OpenAI Moderation API becomes the primary content check on chat,
# usernames, and party names, superseding the keyword denylists. Leave empty and
# the keyword filters run exactly as they always have.
#
# The integration is FAIL-OPEN by design: an absent, invalid, or rate-limited key
# never blocks chat, it just falls back to the keyword layers. The backend will
# NOT refuse to boot without it.
#
# The moderation endpoint is free to use. Check your org's usage tier before
# enabling in production — new accounts are reported to cap around 10k
# requests/day. Get a key at https://platform.openai.com/api-keys
# Docs: docs/moderation/ai-moderation.md
OPENAI_API_KEY=

# Server-only Steam profile lookup, used after verified OpenID login.
STEAM_WEB_API_KEY=
