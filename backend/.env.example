NODE_ENV=development
# Opt-in for credential-less dev-login + /api/admin/sim routes.
# Only honored when NODE_ENV=development; ignored in production.
ENABLE_DEV_LOGIN=false
PORT=7076
DB_HOST=localhost
DB_PORT=5432
DB_USER=fo76_user
DB_PASSWORD=change-me
DB_NAME=fo76_chat
REDIS_HOST=localhost
REDIS_PORT=6379
CLIENT_ORIGINS=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-secret
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_SERVER_ID=
DISCORD_REDIRECT_URI=http://localhost:7076/auth/discord/callback
OWNER_ROLE_ID=
ADMIN_ROLE_ID=
MODERATOR_ROLE_ID=
# Staff role for the ticketing feature (developers). Owner/Admin/Moderator reuse the ids above.
DEVELOPER_ROLE_ID=

# --- GitHub ticketing (Discord <-> GitHub Issues/Projects) ---
# Fine-grained PAT (owner UNN-Devotek) with Issues: Read/Write + Projects: Read/Write.
# Leave empty to disable the ticketing feature.
GITHUB_PAT=
GITHUB_OWNER=UNN-Devotek
GITHUB_REPO=FCM-Fallout-Chat-Mod
# Project v2 numbers (/users/UNN-Devotek/projects/<N>): bug+suggestion board, roadmap board.
GITHUB_PROJECT_BUGS_NUMBER=2
GITHUB_PROJECT_ROADMAP_NUMBER=3
# HMAC secret for verifying inbound GitHub webhooks (X-Hub-Signature-256). Set the same value on the repo webhook.
GITHUB_WEBHOOK_SECRET=

# Desktop client registration key (leave empty to skip validation)
APP_CLIENT_KEY=fo76-chat-desktop-v1
ADMIN_RELEASE_TOKEN=change-me-to-a-long-random-secret
# Admin API key — pass as X-API-Key header to bypass Discord OAuth on all admin endpoints
ADMIN_API_KEY=change-me-to-a-long-random-secret
# HUD push — DEV-ONLY for now: both transports refuse to start when NODE_ENV=production
# (guard removed as part of the M6 production-exposure milestone; see docs/overlay/zfe/realtime-socket.md).
# Raw TCP front-end (Path A). Set to true and configure ZFE_TEXT_CHAT_ENDPOINT=host:port.
HUD_PUSH_TCP_ENABLED=false
HUD_PUSH_TCP_PORT=4001
# Bind host for the TCP HUD push listener. Default: 127.0.0.1 (loopback only).
# Set to 0.0.0.0 only when the game client runs on a different host (unusual).
HUD_PUSH_TCP_HOST=127.0.0.1
# TLS for the TCP HUD push listener. ZFE wraps host:port endpoints in Schannel TLS 1.2 and does NOT
# validate the certificate — a self-signed cert is sufficient. Set both vars to paths of PEM files to
# enable TLS; leave both empty to use plaintext (ZFE cannot connect to a plaintext listener).
# See docs/overlay/zfe/realtime-socket.md "Probe findings" for full context.
# Dev cert: openssl req -x509 -newkey rsa:2048 -nodes -keyout certs/dev/hud-push.key -out certs/dev/hud-push.crt -days 730 -subj "/CN=fcm-hud-dev"
HUD_PUSH_TCP_TLS_CERT=
HUD_PUSH_TCP_TLS_KEY=
# WebSocket front-end (Path B). Set to true and configure ZFE_TEXT_CHAT_ENDPOINT=ws://host:port/ws/hud.
HUD_PUSH_WS_ENABLED=false
# M7 two-way in-game chat: HMAC-SHA256 key for deriving identityHash from FO76 accountName.
# Required when HUD_PUSH_TCP_ENABLED=true and the inbound parser is active.
# Dev default is allowed; must be a strong (>=32 char) random secret in production.
HUD_IDENTITY_SECRET=dev-hud-identity-secret-change-me
