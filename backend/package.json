{
  "name": "fo76-chat-backend",
  "version": "1.0.1",
  "description": "Fallout Chat Mod Backend Server",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "jest --runInBand --forceExit",
    "test:unit": "node --import tsx src/testRunner.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@prisma/client": "^5.22.0",
    "@types/tar-stream": "^3.1.4",
    "argon2": "^0.45.0",
    "bull": "^4.16.5",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.5",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.1",
    "file-type": "^21.3.4",
    "helmet": "^8.3.0",
    "joi": "^18.2.5",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "node-emoji": "^2.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "rate-limit-redis": "^6.0.0",
    "redis": "^6.2.1",
    "tar-stream": "^3.2.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/connect-redis": "^0.0.23",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/pino": "^7.0.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "undici": "^6.27.0",
    "js-yaml": "^3.15.0",
    "brace-expansion@1": "^1.1.16",
    "brace-expansion@2": "^2.1.4",
    "brace-expansion@5": "^5.0.7"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {
      "\\.[jt]sx?$": [
        "<rootDir>/tests/setup/ts-transform.js",
        {}
      ]
    },
    "moduleNameMapper": {
      "^file-type$": "<rootDir>/tests/setup/file-type-stub.js",
      "^connect-redis$": "<rootDir>/tests/setup/connect-redis-stub.js"
    },
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "allowScripts": {
    "argon2@0.44.0": true
  }
}
