# =============================================================================
# Fallout Chat Mod — hosted-dev env template  (Dokploy project: "fcm-dev")
# =============================================================================
# Set these in the Dokploy "fcm-dev" PROJECT ENV — NOT in the repo, and NEVER
# reuse any production value. The dev stack must have ZERO secret overlap with
# prod (SR-001). Placeholders only below.
#
# Used by: deploy/dev/docker-compose.yml
# Spec:    docs/deployment/hosted-dev-environment.md
# =============================================================================

# ── Cloudflare dev tunnel ────────────────────────────────────────────────────
# Token for the DEDICATED cloudflared-dev tunnel (separate from prod's tunnel).
# Issued in Cloudflare Zero Trust → Networks → Tunnels → create "fcm-dev".
CLOUDFLARE_TUNNEL_TOKEN=replace-with-dev-tunnel-token

# ── Postgres (dev-only) ──────────────────────────────────────────────────────
DB_USER=fo76_dev_user
DB_PASSWORD=replace-with-strong-dev-db-password
DB_NAME=fo76_chat_dev

# ── Redis (dev-only) ─────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
REDIS_PASSWORD=replace-with-strong-dev-redis-password

# ── MinIO (dev-only) ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=replace-with-dev-minio-user
MINIO_ROOT_PASSWORD=replace-with-strong-dev-minio-password
MINIO_BUCKET=fcm-dev-avatars

# ── CORS / WS origins ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://dev.falloutchatmod.com
CLIENT_ORIGINS=https://dev.falloutchatmod.com

# ── Dev Discord application (SEPARATE app + throwaway dev server) ─────────────
# Its own client ID / secret / bot token — never prod's. Bot lives ONLY in the
# dev server. Redirect URI → https://dev.falloutchatmod.com/auth/discord/callback
DISCORD_TOKEN=replace-with-dev-bot-token
DISCORD_CHANNEL_ID=replace-with-dev-bridge-channel-id
DISCORD_CLIENT_ID=replace-with-dev-app-client-id
DISCORD_CLIENT_SECRET=replace-with-dev-app-client-secret
DISCORD_SERVER_ID=replace-with-dev-guild-id
DISCORD_REDIRECT_URI=https://dev.falloutchatmod.com/auth/discord/callback
# Dev-guild role IDs (cloned roles get BRAND-NEW IDs; use clone-discord-layout.ts output)
OWNER_ROLE_ID=replace-with-dev-owner-role-id
ADMIN_ROLE_ID=replace-with-dev-admin-role-id
MODERATOR_ROLE_ID=replace-with-dev-moderator-role-id
DEVELOPER_ROLE_ID=replace-with-dev-developer-role-id
SUPPORT_ROLE_ID=replace-with-support-role-id

# ── GitHub ticketing (Discord <-> GitHub Issues/Projects) ────────────────────
# Fine-grained PAT (owner UNN-Devotek): Issues R/W + Projects R/W. Same token as prod's GITHUB_PAT.
GITHUB_PAT=replace-with-github-fine-grained-pat
GITHUB_OWNER=UNN-Devotek
GITHUB_REPO=FCM-Fallout-Chat-Mod
# Single master Project v2 board (all issues + features), e.g. /users/UNN-Devotek/projects/5
GITHUB_PROJECT_NUMBER=5
# Same value as the repo webhook secret (used in increment 2 for inbound sync).
GITHUB_WEBHOOK_SECRET=replace-with-webhook-hmac-secret

# ── Dual Discord role gate (access control for the hosted dev env) ───────────
# A user must hold the developer role in BOTH guilds. Dev-guild check is local;
# prod-guild check goes through the prod-bot verify endpoint (PROD_VERIFY_*).
PROD_GUILD_ID=replace-with-production-guild-id
PROD_DEVELOPER_ROLE_ID=replace-with-prod-developer-role-id
DEV_GUILD_ID=replace-with-dev-guild-id
DEV_DEVELOPER_ROLE_ID=replace-with-dev-developer-role-id
# Prod-side narrow verify endpoint + shared service token (returns only a boolean).
PROD_VERIFY_URL=https://falloutchatmod.com/api/internal/verify-dev-role
PROD_VERIFY_TOKEN=replace-with-prod-verify-service-token

# ── Dev-only admin / session secrets (SR-001 — NEVER prod's) ─────────────────
# Generate each independently: openssl rand -base64 32
ADMIN_API_KEY=replace-with-strong-dev-admin-api-key
SESSION_SECRET=replace-with-strong-dev-session-secret

# ── Overlay registration shared key ───────────────────────────────────────
# Must match the overlay's baked DEFAULT_APP_CLIENT_KEY (overlay-core.js). The dev
# compose defaults to this value; set here to override. Without it reaching the
# backend, POST /api/users 503s "Registration unavailable: server misconfigured".
APP_CLIENT_KEY=fo76-chat-desktop-v1
