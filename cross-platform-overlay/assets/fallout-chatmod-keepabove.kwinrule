# Fallout Chat Mod — KDE/KWin window rules (manual-import fallback)
#
# The overlay applies these AUTOMATICALLY on startup (KDE+Wayland). This file is a
# fallback you can import by hand if the automatic path didn't work:
#   System Settings -> Window Management -> Window Rules -> Import...  (pick this file)
#   then:  qdbus org.kde.KWin /KWin reconfigure   (or log out / in)
#
# ONE rule on the OVERLAY window (wmclass=fallout-chat-mod), combining two KWin
# properties:
#
# 1) Keep the OVERLAY above other windows (above=true) — belt-and-suspenders.
# 2) Force the OVERLAY into KWin's Overlay layer (layer=overlay, Force) — the
#    sanctioned KWin-6 way (KDE Bug 441074) to stay above a FOCUSED fullscreen game.
#    The game is NOT demoted: FO76 keeps its normal fullscreen stacking (above the
#    panel), and the overlay stays a normal, focusable, alt-tab-able window.
[Fallout Chat Mod - keep above games]
Description=Fallout Chat Mod - keep above games
wmclass=fallout-chat-mod
wmclassmatch=2
wmclasscomplete=false
above=true
aboverule=3
layer=overlay
layerrule=2
