<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for Hardened Runtime (macOS notarization). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Allow unsigned executable memory (required by Electron's V8 JIT). -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Allow dyld environment variables (required by some native modules). -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Network access for the relay WebSocket + HTTP proxy. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Audio/video not needed; keep off. -->
  </dict>
</plist>
