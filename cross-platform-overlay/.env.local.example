# cross-platform-overlay environment variables — copy to .env.local and fill in.
# These override the production defaults baked into main.js.
#
# ── Path A (cloud dev backend) ──────────────────────────────────────────────────
# Point the overlay at dev.falloutchatmod.com instead of prod. The dev API/WS is
# exposed on a non-Cloudflare-Access path, so only the normal install-token/session
# auth flow is required — no CF service token headers are needed.
#
# Use the dev:cloud npm script (sets these automatically via cross-env):
#   npm run dev:cloud
#
# Or set them manually here if you need a one-off build/start against the dev backend:
# M-5: commented out so a plain copy does not silently point at dev.
# RELAY_HTTP=https://dev.falloutchatmod.com
# RELAY_WS=wss://dev.falloutchatmod.com/ws
#
# ── Path B (local backend) ──────────────────────────────────────────────────────
# Point the overlay at your local backend (docker-compose or npm run dev in backend/).
# Use the dev:local / start:local npm scripts (set these automatically via cross-env):
#   npm run dev:local
#
# Or manually:
# RELAY_HTTP=http://localhost:7177
# RELAY_WS=ws://localhost:7177/ws
#
# ── Production (default — no override needed) ───────────────────────────────────
# When neither variable is set, main.js falls back to:
#   RELAY_HTTP=https://falloutchatmod.com
#   RELAY_WS=wss://falloutchatmod.com/ws
