{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "allowJs": true,
    "esModuleInterop": true,
    // TypeScript 7 removed `baseUrl`. Since TS 5 `paths` entries resolve relative
    // to this tsconfig.json's own directory, so the `@dashboard/*` mapping below
    // works unchanged without it.
    "paths": {
      "@dashboard/*": ["../admin-dashboard/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
