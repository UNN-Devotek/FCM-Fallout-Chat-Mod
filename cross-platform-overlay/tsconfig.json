{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "allowJs": true,
    "esModuleInterop": true,
    // TypeScript 6 deprecates `baseUrl` (removed in 7.0). Silence the deprecation
    // error for now; the `@dashboard/*` path mapping still resolves via baseUrl.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@dashboard/*": ["../admin-dashboard/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
