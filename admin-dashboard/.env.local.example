# admin-dashboard/.env.local.example
# Copy to .env.local and fill in values. This file is safe to commit.

# ── Path A: remote dev backend ────────────────────────────────────────────────
# Set this to a running backend (local or cloud) to have the Vite dev server
# proxy /api, /auth, and /ws there instead of localhost:7177.
#
# Path A (cloud dev backend):
#   VITE_API_URL=https://dev.falloutchatmod.com
#
# Path B (full local stack — default, VITE_API_URL is not needed):
#   Leave unset; the proxy uses http://localhost:7177 automatically.
#   Start the local stack first: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
#
# VITE_API_URL=https://dev.falloutchatmod.com

# ── Dev persona switcher ──────────────────────────────────────────────────────
# Show the floating DEV persona switcher in the UI (auto-login as admin/mod/etc).
# Only works when the backend has dev-login routes enabled (NODE_ENV=development).
# VITE_DEV_PERSONAS=true
