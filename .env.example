# ── Backend & Infrastructure ─────────────────────────────────────────────────
NODE_ENV=development
PORT=7076

# PostgreSQL
DB_HOST=postgres
DB_PORT=7077
DB_USER=fo76_user
DB_PASSWORD=change_me_in_production
DB_NAME=fo76_chat

# Redis
REDIS_HOST=redis
REDIS_PORT=7078
# Required in production (compose fails fast if unset). Generate: openssl rand -base64 32
REDIS_PASSWORD=REDACTED
# Optional full URL form; if set the app prefers this over host/port/password
REDIS_URL=

# MinIO object storage — NO defaults in production (old public defaults were
# fo76minio / REDACTED; if those were ever live, rotate + audit the bucket).
MINIO_ROOT_USER=devminio
MINIO_ROOT_PASSWORD=REDACTED

# CORS (comma-separated allowed origins)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:7076
# Tightened allow-list for prod WS/HTTP origin checks (defaults to CLIENT_ORIGINS if unset)
ALLOWED_ORIGINS=https://falloutchatmod.com

# Proxy / edge — backend sits behind Traefik (+ Cloudflare). When true, the app
# reads the real client IP from CF-Connecting-IP / trusted X-Forwarded-For.
TRUST_PROXY=true

LOG_LEVEL=info
MESSAGE_RETENTION_DAYS=90

# ── Discord Chat Bridge ───────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# ── Discord OAuth2 (Admin Dashboard) ─────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_SERVER_ID=
OWNER_ROLE_ID=
ADMIN_ROLE_ID=
MODERATOR_ROLE_ID=

# Dashboard callback URL (update to production domain)
DISCORD_REDIRECT_URI=http://localhost:7076/auth/discord/callback

# Session secret for admin dashboard sessions
SESSION_SECRET=change_me_to_a_long_random_string_in_production

# ── Local dev quick-start ──────────────────────────────────────────────
# These let the stack run fully locally with NO Discord bot. Discord is only
# required in production (the NODE_ENV=production boot guard enforces it).
ENABLE_DEV_LOGIN=true                 # sign in via /auth/dev-login/<persona> (no Discord OAuth)
APP_CLIENT_KEY=fo76-chat-desktop-v1   # must match the overlay default so it can register
MINIO_BUCKET=fcm-avatars
# DISCORD_* may stay empty in dev — the bridge just disables itself.

# ── Release script (Packaging/release.ps1) ────────────────────────────────────
# SSH target and key for uploading artifacts to the VPS. Set these in .env.local
# (gitignored) so release.ps1 picks them up without requiring user env vars.
FCM_SSH_TARGET=user@your-server-ip
FCM_SSH_KEY=~/.ssh/your_key
# Nexus Mods release groups (the HUD group is a separate optional file group on the mod page)
NEXUS_FILE_GROUP_ID_WINDOWS=
NEXUS_FILE_GROUP_ID_LINUX=
NEXUS_FILE_GROUP_ID_HUD=
